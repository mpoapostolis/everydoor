{
  "name": "voxel-city-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/demo dev",
    "build": "bun run --cwd apps/demo build",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test.mjs",
    "preview": "bun run --cwd apps/demo preview"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "three": "^0.185.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
